# Создай бота через @BotFather в Telegram, получишь TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# ID чата/канала, куда бот будет присылать заявки с формы.
# Проще всего: напиши боту любое сообщение, затем открой
# https://api.telegram.org/bot<TOKEN>/getUpdates и найди "chat":{"id": ...}
TELEGRAM_CHAT_ID=
